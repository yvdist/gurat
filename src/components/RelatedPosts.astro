---
// Related posts (spec 06 §6.5): tag-sharing visible posts below PrevNext.
// No heading, no new strings or tokens — links reuse the prevnext card
// classes. Omitted entirely when empty (caller renders nothing).
import type { Locale } from "../config/site";
import { localizePath } from "../i18n";
import type { RelatedPost } from "../server/db/posts";

interface Props {
	locale: Locale;
	related: RelatedPost[];
}

const { locale, related } = Astro.props;
---

{
	related.length > 0 && (
		<div class="related">
			{related.map((r) => (
				<a class="prevnext-card" href={localizePath(`/writing/${r.slug}`, locale)}>
					<p class="prevnext-title">{r.title}</p>
				</a>
			))}
		</div>
	)
}
