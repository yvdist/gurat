---
// Segmented light/dark/auto control (spec §A2, plan step 5). A <button>
// group, keyboard-operable, aria-pressed; total page JS ≤ 3 KB.
import type { Locale } from "../config/site";
import { t } from "../i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<div class="seg theme-seg" role="group" aria-label={t(locale, "theme.label")}>
	<button type="button" data-theme-value="light" aria-pressed="false">
		{t(locale, "theme.light")}
	</button>
	<button type="button" data-theme-value="dark" aria-pressed="false">
		{t(locale, "theme.dark")}
	</button>
	<button type="button" data-theme-value="auto" aria-pressed="true">
		{t(locale, "theme.auto")}
	</button>
</div>
