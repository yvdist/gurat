---
// Site header (spec §A2): logo lockup (indigo square + SITE.name wordmark),
// right mono nav + en/id segmented switch + theme toggle.
import { type Locale, SITE } from "../config/site";
import { localizePath, t } from "../i18n";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	locale: Locale;
	path: string;
}

const { locale, path } = Astro.props;
const otherLocale: Locale = locale === "en" ? "id" : "en";
---

<header class="site-header">
	<div class="page">
		<a class="brand" href={localizePath("/", locale)}>
			<span class="brand-mark" aria-hidden="true">余</span>
			<span class="brand-name">{SITE.name}</span>
		</a>
		<nav class="site-nav" aria-label={t(locale, "nav.primary")}>
			<ul class="nav-links">
				<li>
					<a href={localizePath("/writing", locale)}>{t(locale, "nav.writing")}</a>
				</li>
				<li>
					<a href={localizePath("/tags", locale)}>{t(locale, "nav.tags")}</a>
				</li>
				<li>
					<a href={localizePath("/about", locale)}>{t(locale, "nav.about")}</a>
				</li>
			</ul>
			<div class="seg" role="group" aria-label="Language">
				<button
					type="button"
					aria-pressed={locale === "en" ? "true" : "false"}
					data-locale-href={localizePath(path, "en")}>en</button
				>
				<button
					type="button"
					aria-pressed={locale === "id" ? "true" : "false"}
					data-locale-href={localizePath(path, otherLocale)}>id</button
				>
			</div>
			<ThemeToggle locale={locale} />
		</nav>
	</div>
</header>
