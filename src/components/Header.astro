---
// Site header: gurat lowercase Newsreader wordmark (shared Wordmark) with
// hand-drawn underline stroke left; right mono nav WRITING ABOUT MENU +.
// MENU + is a <button aria-expanded> opening the overlay (Step 3b).
import type { Locale } from "../config/site";
import { localizePath, t } from "../i18n";
import MenuOverlay from "./MenuOverlay.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
	locale: Locale;
	path: string;
}

const { locale, path } = Astro.props;
---

<header class="site-header">
	<div class="page">
		<a class="brand" href={localizePath("/", locale)} aria-label="gurat — home">
			<Wordmark />
		</a>
		<nav class="site-nav" aria-label={t(locale, "nav.primary")}>
			<ul class="nav-links">
				<li>
					<a href={localizePath("/writing", locale)}>{t(locale, "nav.writing")}</a>
				</li>
				<li>
					<a href={localizePath("/about", locale)}>{t(locale, "nav.about")}</a>
				</li>
			</ul>
			<button
				type="button"
				class="menu-open"
				aria-expanded="false"
				aria-controls="menu-overlay"
				data-menu-open
			>
				{t(locale, "menu.open")}
			</button>
		</nav>
	</div>
</header>
<MenuOverlay locale={locale} path={path} />
