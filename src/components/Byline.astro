---
// Byline box: written-by line + COPY LINK / RSS / EMAIL action row.
// Clipboard script already lives in Base (`[data-copy-link]`); EMAIL is a
// plain mailto: link to the owner contact address.
import { type Locale, SITE } from "../config/site";
import { localizePath, t } from "../i18n";

interface Props {
	locale: Locale;
	canonical: string;
	email: string;
}

const { locale, canonical, email } = Astro.props;
---

<div class="byline">
	<p>
		{t(locale, "post.writtenBy").replace("{name}", SITE.name)}
	</p>
	<div class="byline-actions">
		<button
			type="button"
			data-copy-link={canonical}
			data-copied={t(locale, "post.copied")}
			aria-live="polite"
		>
			{t(locale, "post.copyLink")}
		</button>
		<a class="mono" href={localizePath("/feed.xml", locale)}>{t(locale, "post.rss")}</a>
		<a class="mono" href={`mailto:${email}`}>{t(locale, "post.email")}</a>
	</div>
</div>
