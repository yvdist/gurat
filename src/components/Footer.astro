---
// Site footer (spec §A2): hairline, mono © {year} {name}, center 余白,
// rss links to the locale feed (Phase 6).
import { type Locale, SITE } from "../config/site";
import { localizePath, t } from "../i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="page">
		<p class="rights">{t(locale, "footer.rights").replace("{year}", String(year)).replace("{name}", SITE.name)}</p>
		<p class="accent" aria-hidden="true">余白</p>
		<p class="rss"><a href={localizePath("/feed.xml", locale)} type="application/rss+xml">{t(locale, "footer.rss")}</a></p>
	</div>
</footer>
