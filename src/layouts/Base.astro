---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { Locale } from "../config/site";
import { SITE } from "../config/site";
import { t } from "../i18n";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/article.css";
// Self-hosted faces: Newsreader (latin + latin-ext for ID glyphs) + IBM Plex
// Mono labels (latin). Kanji accents render in the system CJK stack from
// --font-cjk — never a CJK webfont. font-display: swap via fontsource.
import "@fontsource/newsreader/latin-400.css";
import "@fontsource/newsreader/latin-400-italic.css";
import "@fontsource/newsreader/latin-500.css";
import "@fontsource/newsreader/latin-ext-400.css";
import "@fontsource/newsreader/latin-ext-400-italic.css";
import "@fontsource/newsreader/latin-ext-500.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";

// Preload the faces first paint actually uses: Newsreader 400 (body + titles
// render weight 500 inherits the latin file below), latin-ext 400 (ID glyphs
// arrive in the ext file; late swap reflows above-fold text — measured
// ID-post CLS 0.17 without it), mono 400 (inline <code>). All same-origin,
// no CSP change.
import plexmono400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import newsreader400 from "@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url";
import newsreaderExt400 from "@fontsource/newsreader/files/newsreader-latin-ext-400-normal.woff2?url";

interface Hreflang {
	locale: Locale;
	href: string;
}
interface Props {
	title: string;
	description: string;
	canonical: string;
	hreflangs: Hreflang[];
	locale: Locale;
	path: string;
	noindex?: boolean;
	ogImage?: string;
	ogType?: "website" | "article";
	publishedAt?: number;
	updatedAt?: number;
	jsonLd?: string;
}

const {
	title,
	description,
	canonical,
	hreflangs,
	locale,
	path,
	noindex = false,
	ogImage = `${SITE.url}/og-default.png`,
	ogType = "website",
	publishedAt,
	updatedAt,
	jsonLd,
} = Astro.props;
const fullCanonical = `${SITE.url}${canonical}`;
const ogLocale = locale === "id" ? "id_ID" : "en_US";
const ogLocaleAlternate = locale === "id" ? "en_US" : "id_ID";
---

<!doctype html>
<html lang={locale} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="description" content={description} />
		<link rel="canonical" href={fullCanonical} />
		{
			hreflangs.map((h) => (
				<link rel="alternate" hreflang={h.locale} href={`${SITE.url}${h.href}`} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={`${SITE.url}${hreflangs.find((h) => h.locale === SITE.defaultLocale)?.href ?? canonical}`} />
		<link rel="alternate" type="application/rss+xml" hreflang="en" href={`${SITE.url}/feed.xml`} title={`${SITE.name} (en)`} />
		<link rel="alternate" type="application/rss+xml" hreflang="id" href={`${SITE.url}/id/feed.xml`} title={`${SITE.name} (id)`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={fullCanonical} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{ogType === "article" && publishedAt !== undefined && <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />}
		{ogType === "article" && updatedAt !== undefined && <meta property="article:modified_time" content={new Date(updatedAt).toISOString()} />}
		{/* Server-serialized JSON-LD from validated post fields (JSON.stringify,
		    never author HTML) — safe the same way ArticleBody's set:html is. */}
		{jsonLd !== undefined && <script type="application/ld+json" set:html={jsonLd} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/site.webmanifest" />
		<link
			rel="preload"
			href={newsreader400}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href={plexmono400}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href={newsreaderExt400}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<script>
			try {
				var t = localStorage.getItem("gurat-theme");
				document.documentElement.dataset.theme =
					t === "light" || t === "dark"
						? t
						: matchMedia("(prefers-color-scheme: dark)").matches
							? "dark"
							: "light";
			} catch (e) {
				document.documentElement.dataset.theme = "light";
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">{t(locale, "nav.skip")}</a>
		<Header locale={locale} path={path} />
		<main id="main">
			<slot />
		</main>
		<Footer locale={locale} />
		<script>
			(function () {
				var r = document.documentElement;
				var sync = function (t: string): void {
					document
						.querySelectorAll("[data-theme-value]")
						.forEach(function (b: Element): void {
							b.setAttribute(
								"aria-pressed",
								String(b.getAttribute("data-theme-value") === t),
							);
						});
				};
				var set = function (t: string): void {
					try {
						localStorage.setItem("gurat-theme", t);
					} catch (e) {}
					r.dataset.theme = t;
					sync(t);
				};
				var init: string | null = null;
				try {
					init = localStorage.getItem("gurat-theme");
				} catch (e) {}
				sync(
					init === "light" || init === "dark"
						? init
						: matchMedia("(prefers-color-scheme: dark)").matches
							? "dark"
							: "light",
				);
				document
					.querySelectorAll("[data-theme-value]")
					.forEach(function (b: Element): void {
						b.addEventListener("click", function (): void {
							var v = b.getAttribute("data-theme-value");
							if (v) set(v);
						});
					});
				var overlay = document.querySelector("[data-menu-overlay]");
				var openers = document.querySelectorAll(
					"[data-menu-open][aria-expanded]",
				);
				var lastFocus: Element | null = null;
				var openMenu = function (): void {
					if (overlay === null) return;
					lastFocus = document.activeElement;
					overlay.removeAttribute("hidden");
					document.body.style.overflow = "hidden";
					openers.forEach(function (o: Element): void {
						o.setAttribute("aria-expanded", "true");
					});
					var c = overlay.querySelector("[data-menu-close]");
					if (c instanceof HTMLElement) c.focus();
				};
				var closeMenu = function (): void {
					if (overlay === null) return;
					overlay.setAttribute("hidden", "");
					document.body.style.overflow = "";
					openers.forEach(function (o: Element): void {
						o.setAttribute("aria-expanded", "false");
					});
					if (lastFocus instanceof HTMLElement) lastFocus.focus();
				};
				openers.forEach(function (o: Element): void {
					o.addEventListener("click", openMenu);
				});
				if (overlay !== null) {
					var ov = overlay;
					ov.querySelectorAll("[data-menu-close]").forEach(function (
						b: Element,
					): void {
						b.addEventListener("click", closeMenu);
					});
					document.addEventListener("keydown", function (e: Event): void {
						if (!(e instanceof KeyboardEvent)) return;
						if (e.key !== "Escape" || ov.hasAttribute("hidden")) return;
						closeMenu();
					});
					ov.addEventListener("keydown", function (e: Event): void {
						if (!(e instanceof KeyboardEvent)) return;
						if (e.key !== "Tab") return;
						var f = ov.querySelectorAll("a[href], button:not([disabled])");
						if (f.length === 0) return;
						var first = f[0];
						var last = f[f.length - 1];
						if (
							e.shiftKey &&
							document.activeElement === first &&
							last instanceof HTMLElement
						) {
							e.preventDefault();
							last.focus();
						} else if (
							!e.shiftKey &&
							document.activeElement === last &&
							first instanceof HTMLElement
						) {
							e.preventDefault();
							first.focus();
						}
					});
				}
				var copy = document.querySelector("[data-copy-link]");
				if (copy !== null) {
					var target: Element = copy;
					var u = target.getAttribute("data-copy-link");
					var done = target.getAttribute("data-copied") || "copied";
					target.addEventListener("click", function (): void {
						if (navigator.clipboard && u) {
							navigator.clipboard.writeText(u).then(function (): void {
								target.textContent = done;
							});
						}
					});
				}
			})();
		</script>
	</body>
</html>
