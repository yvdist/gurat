---
import EditorIsland from "../../../islands/Editor.svelte";
import Admin from "../../../layouts/Admin.astro";
import { getEnv } from "../../../lib/env";
import { listAllTagsService } from "../../../server/admin/service";
import type { AccessIdentity } from "../../../server/auth/access";
import { requireAdminPage } from "../../../server/auth/access";
import { createDb, getPostById, listAdminPosts } from "../../../server/db";
import { listMediaService } from "../../../server/media/service";

export const prerender = false;

const env = getEnv();
let identity: AccessIdentity;
try {
	identity = await requireAdminPage(
		Astro.request,
		env,
		new URL(Astro.request.url),
		{ isDev: import.meta.env.DEV },
	);
} catch (res) {
	if (res instanceof Response) return res;
	throw res;
}

const db = createDb(env.DB);
let post = null;
try {
	post = await getPostById(db, Astro.params.id ?? "");
} catch {
	post = null;
}
if (post === null) {
	Astro.response.status = 404;
}
const tags = await listAllTagsService(db);
const recent = await listAdminPosts(db, { limit: 50 });
const mediaItems = await listMediaService(db);
const logoutUrl = `${env.ACCESS_TEAM_DOMAIN || "https://login.invalid"}/cdn-cgi/access/logout`;
---

{post === null ? (
	<Admin title="Not found" email={identity.email} current="posts" logoutUrl={logoutUrl}>
		<p>Post not found.</p>
	</Admin>
) : (
	<Admin title={`Edit — ${post.title || "(untitled)"}`} email={identity.email} current="posts" logoutUrl={logoutUrl}>
		<EditorIsland
			client:only="svelte"
			postId={post.id}
			initialDoc={post.contentJson}
			initialUpdatedAt={post.updatedAt}
			locale={post.locale === "id" ? "id" : "en"}
			groupId={post.translationGroupId}
			candidates={recent
				.filter((r) => r.id !== post.id && r.locale !== post.locale)
				.map((r) => ({
					id: r.id,
					locale: r.locale === "id" ? "id" : "en",
					title: r.title,
					slug: r.slug,
					groupId: r.translationGroupId,
					updatedAt: r.updatedAt,
				}))}
			mediaBaseUrl={env.MEDIA_BASE_URL}
			initialTitle={post.title}
			initialSlug={post.slug}
			initialExcerpt={post.excerpt}
			initialSeo={post.seoDescription}
			initialCoverId={post.coverMediaId}
			initialTagIds={post.tags.map((t) => t.id)}
			initialPublishedAt={post.publishedAt}
			initialStatus={post.status === "published" ? "published" : "draft"}
			allTags={tags.map((t) => ({ id: t.id, slug: t.slug }))}
			allMedia={mediaItems.map((m) => ({
				id: m.id,
				altDefault: m.altDefault,
				width: m.width,
				height: m.height,
			}))}
		/>
	</Admin>
)}
