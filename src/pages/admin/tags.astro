---
import Admin from "../../layouts/Admin.astro";
import { getEnv } from "../../lib/env";
import {
	createTagService,
	deleteTagService,
	listAllTagsService,
	renameTagService,
} from "../../server/admin/service";
import type { AccessIdentity } from "../../server/auth/access";
import { requireAdminPage } from "../../server/auth/access";
import { createDb } from "../../server/db";

export const prerender = false;

const env = getEnv();
let identity: AccessIdentity;
try {
	identity = await requireAdminPage(
		Astro.request,
		env,
		new URL(Astro.request.url),
		{ isDev: import.meta.env.DEV },
	);
} catch (res) {
	if (res instanceof Response) return res;
	throw res;
}

const db = createDb(env.DB);
// Server-rendered forms (no client JS): POSTs land here, call the same
// service the JSON API uses, and re-render with inline errors.
let formError: string | null = null;
if (Astro.request.method === "POST") {
	// Same CSRF rule as the JSON API (spec 04 §4.1): the browser sends the
	// Access cookie automatically, so form posts need an Origin check too.
	const origin = Astro.request.headers.get("Origin") ?? "";
	if (origin !== env.SITE_URL) {
		formError = "csrf";
	} else {
		const data = await Astro.request.formData();
		const action = String(data.get("action") ?? "");
		const id = String(data.get("id") ?? "");
		try {
			if (action === "create") {
				const result = await createTagService(db, {
					slug: String(data.get("slug") ?? ""),
					labelEn: String(data.get("labelEn") ?? ""),
					labelId: String(data.get("labelId") ?? ""),
				});
				if (!result.ok) throw new Error(result.err.code);
			} else if (action === "rename" && id !== "") {
				const result = await renameTagService(db, id, {
					slug: String(data.get("slug") ?? ""),
					labelEn: String(data.get("labelEn") ?? ""),
					labelId: String(data.get("labelId") ?? ""),
				});
				if (!result.ok) throw new Error(result.err.code);
			} else if (action === "delete" && id !== "") {
				const result = await deleteTagService(db, id, {
					confirm: data.get("confirm") === "on",
				});
				if (!result.ok) {
					throw new Error(
						result.err.code === "tag-in-use"
							? `tag-in-use (${result.err.detail ?? 0} posts) — tick confirm to delete anyway`
							: result.err.code,
					);
				}
			}
		} catch (err) {
			formError = err instanceof Error ? err.message : "request failed";
		}
	}
}
const tags = await listAllTagsService(db);
const logoutUrl = `${env.ACCESS_TEAM_DOMAIN || "https://login.invalid"}/cdn-cgi/access/logout`;
---

<Admin title="Tags" email={identity.email} current="tags" logoutUrl={logoutUrl}>
	<h1>Tags</h1>

	{formError !== null && <p class="admin-error" role="alert">{formError}</p>}

	<section class="admin-card" aria-label="Create tag">
		<h2>Create</h2>
		<form method="post" id="tag-create">
			<input type="hidden" name="action" value="create" />
			<div class="admin-create-grid">
				<div class="admin-field">
					<span>Slug (lowercase-hyphen)</span>
					<input name="slug" required maxlength={64} pattern="[a-z0-9]+(?:-[a-z0-9]+)*" />
				</div>
				<div class="admin-field">
					<span>Label (EN)</span>
					<input name="labelEn" required maxlength={120} />
				</div>
				<div class="admin-field">
					<span>Label (ID)</span>
					<input name="labelId" required maxlength={120} />
				</div>
			</div>
			<button type="submit" class="admin-btn-primary">Create tag</button>
		</form>
	</section>

	<section aria-label="Existing tags">
		<h2>Existing</h2>
		<ul class="admin-tag-list">
			{tags.map((t) => (
				<li data-tag-id={t.id} data-tag-slug={t.slug} data-tag-en={t.labelEn} data-tag-id-label={t.labelId} data-tag-count={t.useCount}>
					<span class="admin-tag-slug">{t.slug}</span>
					<span>{t.labelEn}</span>
					<span>{t.labelId}</span>
					<span class="admin-tag-meta">{t.useCount} {t.useCount === 1 ? "post" : "posts"}</span>
					<span class="admin-tag-actions">
						<button type="button" data-tag-edit={t.id}>Edit</button>
						<button type="button" data-tag-delete={t.id}>Delete</button>
					</span>
				</li>
			))}
		</ul>
	</section>

	<dialog class="admin-dialog" id="tag-edit-dialog" aria-label="Rename tag">
		<form method="dialog" id="tag-edit-form">
			<h2>Rename tag</h2>
			<label class="admin-field">
				<span>Slug (lowercase-hyphen)</span>
				<input name="slug" id="tag-edit-slug" required maxlength={64} pattern="[a-z0-9]+(?:-[a-z0-9]+)*" />
			</label>
			<label class="admin-field">
				<span>Label (EN)</span>
				<input name="labelEn" id="tag-edit-en" required maxlength={120} />
			</label>
			<label class="admin-field">
				<span>Label (ID)</span>
				<input name="labelId" id="tag-edit-id" required maxlength={120} />
			</label>
			<p class="admin-error" id="tag-edit-error" role="alert" hidden></p>
			<button type="submit">Save</button>
			<button type="submit" value="cancel" formnovalidate>Cancel</button>
		</form>
	</dialog>

	<dialog class="admin-dialog" id="tag-delete-dialog" aria-label="Delete tag">
		<form method="dialog" id="tag-delete-form">
			<h2>Delete tag</h2>
			<p id="tag-delete-text"></p>
			<label id="tag-delete-confirm-row" hidden><input type="checkbox" id="tag-delete-confirm" /> in use: delete anyway</label>
			<p class="admin-error" id="tag-delete-error" role="alert" hidden></p>
			<button type="submit" id="tag-delete-submit">Delete</button>
			<button type="submit" value="cancel" formnovalidate>Cancel</button>
		</form>
	</dialog>

	<script>
		import { adminErrorHint, toast } from "../../lib/admin/toast.ts";

		async function readError(res: Response): Promise<{ code: string; detail?: string }> {
			try {
				const body: { error?: unknown; detail?: unknown } = await res.json();
				return {
					code: typeof body.error === "string" ? body.error : `request failed (${res.status})`,
					detail: typeof body.detail === "string" || typeof body.detail === "number" ? String(body.detail) : undefined,
				};
			} catch {
				return { code: `request failed (${res.status})` };
			}
		}

		const editDialog = document.getElementById("tag-edit-dialog");
		const editForm = document.getElementById("tag-edit-form");
		const editSlug = document.getElementById("tag-edit-slug");
		const editEn = document.getElementById("tag-edit-en");
		const editIdInput = document.getElementById("tag-edit-id");
		const editError = document.getElementById("tag-edit-error");
		let editId_ = "";
		for (const btn of document.querySelectorAll("[data-tag-edit]")) {
			btn.addEventListener("click", () => {
				const li = btn.closest("[data-tag-id]");
				if (!(editDialog instanceof HTMLDialogElement) || !li) return;
				editId_ = li.getAttribute("data-tag-id") ?? "";
				if (editSlug instanceof HTMLInputElement) editSlug.value = li.getAttribute("data-tag-slug") ?? "";
				if (editEn instanceof HTMLInputElement) editEn.value = li.getAttribute("data-tag-en") ?? "";
				if (editIdInput instanceof HTMLInputElement) editIdInput.value = li.getAttribute("data-tag-id-label") ?? "";
				if (editError instanceof HTMLElement) editError.hidden = true;
				editDialog.showModal();
			});
		}
		editForm?.addEventListener("submit", async (e) => {
			if (!(editDialog instanceof HTMLDialogElement)) return;
			if (editDialog.returnValue === "cancel") return;
			e.preventDefault();
			const res = await fetch(`/admin/api/tags/${editId_}`, {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					slug: editSlug instanceof HTMLInputElement ? editSlug.value : "",
					labelEn: editEn instanceof HTMLInputElement ? editEn.value : "",
					labelId: editIdInput instanceof HTMLInputElement ? editIdInput.value : "",
				}),
			});
			if (!res.ok) {
				const err = await readError(res);
				const hint = adminErrorHint(err.code, err.detail);
				if (editError instanceof HTMLElement) {
					editError.textContent = hint;
					editError.hidden = false;
				} else {
					toast(hint, "err");
				}
				return;
			}
			toast("Tag saved");
			window.location.reload();
		});

		const deleteDialog = document.getElementById("tag-delete-dialog");
		const deleteForm = document.getElementById("tag-delete-form");
		const deleteText = document.getElementById("tag-delete-text");
		const deleteRow = document.getElementById("tag-delete-confirm-row");
		const deleteCheck = document.getElementById("tag-delete-confirm");
		const deleteError = document.getElementById("tag-delete-error");
		let deleteId_ = "";
		for (const btn of document.querySelectorAll("[data-tag-delete]")) {
			btn.addEventListener("click", () => {
				const li = btn.closest("[data-tag-id]");
				if (!(deleteDialog instanceof HTMLDialogElement) || !li) return;
				deleteId_ = li.getAttribute("data-tag-id") ?? "";
				const slug = li.getAttribute("data-tag-slug") ?? "";
				const count = Number(li.getAttribute("data-tag-count") ?? "0");
				if (deleteText) deleteText.textContent = `Delete tag “${slug}”?`;
				if (deleteRow instanceof HTMLElement) deleteRow.hidden = count === 0;
				if (deleteCheck instanceof HTMLInputElement) deleteCheck.checked = false;
				if (deleteError instanceof HTMLElement) deleteError.hidden = true;
				deleteDialog.showModal();
			});
		}
		deleteForm?.addEventListener("submit", async (e) => {
			if (!(deleteDialog instanceof HTMLDialogElement)) return;
			if (deleteDialog.returnValue === "cancel") return;
			e.preventDefault();
			const res = await fetch(`/admin/api/tags/${deleteId_}`, {
				method: "DELETE",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ confirm: deleteCheck instanceof HTMLInputElement ? deleteCheck.checked : false }),
			});
			if (!res.ok) {
				const err = await readError(res);
				const hint = adminErrorHint(err.code, err.detail);
				if (deleteError instanceof HTMLElement) {
					deleteError.textContent = hint;
					deleteError.hidden = false;
				}
				toast(hint, "err");
				return;
			}
			toast("Tag deleted");
			window.location.reload();
		});
	</script>
	</Admin>
