---
import PostCard from "../components/PostCard.astro";
import { type Locale, SITE } from "../config/site";
import { formatPostDate, localizePath, t } from "../i18n";
import Base from "../layouts/Base.astro";
import { groupByYear, rootHreflangs } from "../lib/archive";
import { getEnv } from "../lib/env";
import { createDb, getPostNos, listPublishedPosts, listTags } from "../server/db";

const locale: Locale = "en";
const db = createDb(getEnv().DB);
const { items: posts } = await listPublishedPosts(db, { locale, limit: 10 });
const tags = await listTags(db, locale);
// Kanji accents per spec §A3: fixed map for the 4 seed slugs; other slugs
// render mono slug only.
const TAG_KANJI: Record<string, string> = {
	essays: "随筆",
	notes: "技術",
	tech: "映画",
	journal: "音楽",
};
const topTags = tags
	.filter((tg) => tg.postCount > 0)
	.sort((a, b) => b.postCount - a.postCount)
	.slice(0, 4);
const featured = posts[0] ?? null;
const latest = posts.slice(1, 4);
const nos = await getPostNos(db, locale, [
	...(featured !== null ? [featured.id] : []),
	...latest.map((p) => p.id),
]);
const archive = posts.slice(0, 5);
const archiveNos = await getPostNos(
	db,
	locale,
	archive.map((p) => p.id),
);
const groups = groupByYear(archive);
const latestYear = groups[0]?.year ?? "";
const primaryTag = (p: (typeof posts)[number]): string => {
	const tag = p.tags[0];
	if (tag === undefined) return "";
	return locale === "en" ? tag.labelEn : tag.labelId;
};
const pad = (n: number): string => String(n).padStart(3, "0");

const description = t(locale, "site.intro");
const canonical = "/";
---

<Base
	title={`${SITE.name} — ${t(locale, "site.tagline")}`}
	description={description}
	canonical={canonical}
	hreflangs={rootHreflangs(canonical)}
	locale={locale}
	path={canonical}
>
	<div class="page">
		<section class="hero">
			<div>
				<p class="mono hero-eyebrow">
					<span class="kanji">随筆</span>
					<span aria-hidden="true"> · </span>
					<span>{featured !== null ? primaryTag(featured) : ""}</span>
				</p>
				<h1>{t(locale, "home.headline")}</h1>
				<p class="hero-lede">{t(locale, "home.lede")}</p>
				<p class="hero-links">
					<a class="mono" href={localizePath("/writing", locale)}
						>{t(locale, "home.allWriting")} →</a
					>
					<span class="mono" aria-hidden="true">{t(locale, "footer.rss")}</span>
				</p>
			</div>
			{
				featured !== null && (
					<figure class="hero-figure">
						<div class="figure-ph tint-blue" aria-hidden="true">
							<div class="wash" />
							<div class="navy" />
							<div class="disc" />
						</div>
						<figcaption>
							<span class="mono">
								{t(locale, "home.featured")} · No. {pad(nos.get(featured.id) ?? 1)} ·{" "}
								{primaryTag(featured)}
							</span>
							<br />
							<a class="featured-title" href={localizePath(`/writing/${featured.slug}`, locale)}>
								{featured.title}
							</a>
						</figcaption>
					</figure>
				)
			}
		</section>

		<section aria-labelledby="latest">
			<div class="section-head">
				<h2 id="latest">{t(locale, "home.latest")}</h2>
				<a class="mono" href={localizePath("/writing", locale)}
					>{t(locale, "home.allWriting")} →</a
				>
			</div>
			{
				posts.length === 0 ? (
					<p>{t(locale, "feed.empty")}</p>
				) : (
					<div class="card-grid">
						{latest.map((p, i) => (
							<PostCard
								locale={locale}
								slug={p.slug}
								title={p.title}
								excerpt={p.excerpt}
								publishedAt={p.publishedAt}
								readingMinutes={p.readingMinutes}
								postNo={pad(nos.get(p.id) ?? 1)}
								tag={primaryTag(p)}
								index={i}
							/>
						))}
					</div>
				)
			}
		</section>

		<section aria-labelledby="topics">
			<div class="section-head">
				<h2 id="topics">{t(locale, "home.topics")}</h2>
				<a class="mono" href={localizePath("/tags", locale)}
					>{t(locale, "home.browseByTag")}</a
				>
			</div>
			<div class="topic-grid">
				{
					topTags.map((tag) => (
						<a class="topic" href={localizePath(`/tags/${tag.slug}`, locale)}>
							<p class="mono kanji">{TAG_KANJI[tag.slug] ?? tag.slug}</p>
							<h3>{locale === "en" ? tag.labelEn : tag.labelId}</h3>
							<p class="mono">{tag.postCount}</p>
						</a>
					))
				}
			</div>
		</section>

		<section aria-labelledby="archive">
			<div class="section-head">
				<h2 id="archive">{t(locale, "home.archive")}</h2>
				<span class="mono">{latestYear}</span>
			</div>
			<div class="archive-layout">
				<div>
					{
						archive.map((p) => (
							<div class="archive-row">
								<span class="mono row-no">No. {pad(archiveNos.get(p.id) ?? 1)}</span>
								<a href={localizePath(`/writing/${p.slug}`, locale)}>{p.title}</a>
								<time
									class="mono"
									datetime={
										p.publishedAt !== null
											? new Date(p.publishedAt).toISOString()
											: undefined
									}
								>
									{p.publishedAt !== null ? formatPostDate(p.publishedAt, locale) : ""}
								</time>
							</div>
						))
					}
				</div>
				<aside class="about-card">
					<div class="avatar" aria-hidden="true">余</div>
					<h3>{t(locale, "home.aboutWriter")}</h3>
					<p>{t(locale, "site.intro")}</p>
					<a class="mono" href={localizePath("/about", locale)}
						>{t(locale, "home.readMore")} →</a
					>
				</aside>
			</div>
		</section>
	</div>
</Base>
