---
import { SITE } from "../config/site";
import { detectLocaleFromPath, localizePath, t } from "../i18n";
import Base from "../layouts/Base.astro";

// Single 404: locale comes from the URL prefix (`/id/...` → Indonesian,
// anything else → English), so `<html lang>` stays correct.
Astro.response.status = 404;
const locale = detectLocaleFromPath(Astro.url.pathname);
---

<Base
	title={`${t(locale, "notfound.title")} — ${SITE.name}`}
	description={t(locale, "notfound.body")}
	canonical={Astro.url.pathname}
	hreflangs={[]}
	locale={locale}
	path={Astro.url.pathname}
>
	<div class="page">
		<div class="center-page">
			<h1>{t(locale, "notfound.title")}</h1>
			<p>{t(locale, "notfound.body")}</p>
			<p>
				<a href={localizePath("/", locale)}>{t(locale, "nav.home")}</a>
			</p>
		</div>
	</div>
</Base>
