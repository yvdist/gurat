---
import type { Locale } from "../config/site";
import { t } from "../i18n";
import Base from "../layouts/Base.astro";
import { rootHreflangs } from "../lib/archive";

const locale: Locale = "en";
const canonical = "/about";
---

<Base
	title={`${t(locale, "about.title")} — Gurat`}
	description={t(locale, "site.intro")}
	canonical={canonical}
	hreflangs={rootHreflangs(canonical)}
	locale={locale}
	heading={t(locale, "about.title")}
>
	<p>{t(locale, "site.intro")}</p>
</Base>
