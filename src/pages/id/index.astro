---
import CoverImg from "../../components/CoverImg.astro";
import { type Locale, SITE } from "../../config/site";
import { localizePath, t } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { figureRefs, listingCoverId, rootHreflangs } from "../../lib/archive";
import { smallestVariantUrl } from "../../lib/content/render";
import { getEnv } from "../../lib/env";
import {
	createDb,
	getMediaById,
	getPostNos,
	listPublishedPosts,
} from "../../server/db";
import type { Media } from "../../server/db/schema";

const locale: Locale = "id";
const db = createDb(getEnv().DB);
const baseUrl = getEnv().MEDIA_BASE_URL;
const { items: posts } = await listPublishedPosts(db, { locale, limit: 10 });
const featured = posts[0] ?? null;
const indexPosts = posts.slice(1);
const nos = await getPostNos(
	db,
	locale,
	posts.map((p) => p.id),
);
const pad = (n: number): string => String(n).padStart(3, "0");
const tagLabel = (p: (typeof posts)[number]): string =>
	p.tags[0] === undefined ? "" : p.tags[0].labelId;
const minutesUnit = t(locale, "archive.minutesUnit");

// Covers resolve from body figures (seed sets no cover_media_id);
// a post with no cover renders a title-only row — never a placeholder box.
// First index row shows 2 photos, subsequent rows 3 (reference rhythm).
const thumbIds = new Map<string, string[]>();
if (featured !== null) {
	const id = listingCoverId(featured);
	thumbIds.set(featured.id, id === null ? [] : [id]);
}
for (const [i, p] of indexPosts.entries()) {
	thumbIds.set(
		p.id,
		figureRefs(p.contentJson)
			.slice(0, i === 0 ? 2 : 3)
			.map((f) => f.mediaId),
	);
}
// About portrait: the fixture whose alt mentions window/light, else the
// featured cover (ID_014 carries "Cahaya pagi di meja yang selesai").
const featuredFigs = featured !== null ? figureRefs(featured.contentJson) : [];
const portraitRef =
	featuredFigs.find((f) => /window|light|cahaya|jendela/i.test(f.alt)) ??
	featuredFigs[0] ??
	null;
const wanted = new Set<string>([...thumbIds.values()].flat());
if (portraitRef !== null) wanted.add(portraitRef.mediaId);
const media = new Map<string, Media>();
for (const id of wanted) {
	const m = await getMediaById(db, id);
	if (m !== null) media.set(id, m);
}
const thumbsOf = (postId: string): Media[] => {
	const ids = thumbIds.get(postId) ?? [];
	const out: Media[] = [];
	for (const id of ids) {
		const m = media.get(id);
		if (m !== undefined) out.push(m);
	}
	return out;
};
const featuredThumbs = featured !== null ? thumbsOf(featured.id) : [];
const featuredCover = featuredThumbs[0] ?? null;
const portrait =
	portraitRef !== null ? (media.get(portraitRef.mediaId) ?? null) : null;
const portraitAlt = portraitRef?.alt ?? portrait?.altDefault ?? "";

const description = t(locale, "site.intro");
const canonical = "/id";
---

<Base
	title={`${SITE.name} — ${t(locale, "site.tagline")}`}
	description={description}
	canonical={canonical}
	hreflangs={rootHreflangs(canonical)}
	locale={locale}
	path={canonical}
>
	{
		posts.length === 0 || featured === null ? (
			<div class="page">
				<p class="home-empty">{t(locale, "empty.home")}</p>
			</div>
		) : (
			<>
				<section aria-labelledby="featured-title">
					{featuredCover !== null && (
						<figure class="feature-figure">
							<CoverImg media={featuredCover} baseUrl={baseUrl} />
						</figure>
					)}
					<div class="page feature-text">
						<div>
							<p class="mono feature-eyebrow">
								NO. {pad(nos.get(featured.id) ?? 1)}
								<span aria-hidden="true"> · </span>
								<span>{t(locale, "home.featured")}</span>
								{tagLabel(featured) !== "" && (
									<>
										<span aria-hidden="true"> · </span>
										<span>{tagLabel(featured)}</span>
									</>
								)}
							</p>
							<h1 id="featured-title" class="feature-title">
								<a href={localizePath(`/writing/${featured.slug}`, locale)}>
									{featured.title}
								</a>
							</h1>
						</div>
						<div>
							<p class="feature-sub">{featured.excerpt}</p>
							<p class="feature-actions">
								<a
									class="mono"
									href={localizePath(`/writing/${featured.slug}`, locale)}
								>
									{t(locale, "home.readEssay")}
								</a>
								<a
									class="mono"
									href={localizePath(`/writing/${featured.slug}`, locale)}
								>
									{t(locale, "home.minutes").replace(
										"{minutes}",
										String(featured.readingMinutes),
									)}
								</a>
							</p>
						</div>
					</div>
				</section>

				<div class="page">
					<section aria-labelledby="index-heading">
						<p id="index-heading" class="mono index-head">
							{t(locale, "home.essaysNotes")}
							<span aria-hidden="true"> · </span>
							<a href="/">EN</a>
							<span aria-hidden="true"> / </span>
							<a href="/id/" aria-current="page">
								ID
							</a>
						</p>
						{indexPosts.map((p, i) => {
							const thumbs = thumbsOf(p.id);
							return (
								<article class="index-row">
									{thumbs.length > 0 && (
										<div class={`index-photos ${i === 0 ? "cols-2" : "cols-3"}`}>
											{thumbs.map((m) => (
												<img
													src={smallestVariantUrl(m, baseUrl)}
													alt={m.altDefault}
													width={m.width}
													height={m.height}
													loading="lazy"
													decoding="async"
												/>
											))}
										</div>
									)}
									<p class="mono index-meta">
										<span>
											NO. {pad(nos.get(p.id) ?? 1)}
											{tagLabel(p) !== "" && (
												<>
													<span aria-hidden="true"> / </span>
													<span>{tagLabel(p)}</span>
												</>
											)}
										</span>
										<span>
											{p.readingMinutes} {minutesUnit}
										</span>
									</p>
									<h2 class="index-title">
										<a href={localizePath(`/writing/${p.slug}`, locale)}>{p.title}</a>
									</h2>
								</article>
							);
						})}
						<p class="index-all">
							<a class="mono" href={localizePath("/writing", locale)}>
								{t(locale, "home.allWritingArrow")}
							</a>
						</p>
					</section>

					<section class="about-preview" aria-label={t(locale, "about.title")}>
						{portrait !== null && (
							<img
								src={smallestVariantUrl(portrait, baseUrl)}
								alt={portraitAlt}
								width={portrait.width}
								height={portrait.height}
								loading="lazy"
								decoding="async"
							/>
						)}
						<div>
							<p class="mono">{t(locale, "about.title")}</p>
							<p class="about-bio">{t(locale, "about.bio")}</p>
							<a class="mono" href={localizePath("/about", locale)}>
								{t(locale, "home.more")}
							</a>
						</div>
					</section>
				</div>
			</>
		)
	}
</Base>
