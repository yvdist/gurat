---
import type { Locale } from "../../../config/site";
import { formatPostDate, localizePath, t } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import { groupByYear, rootHreflangs } from "../../../lib/archive";
import { getEnv } from "../../../lib/env";
import { createDb, getPostNos, listPublishedPosts } from "../../../server/db";

const locale: Locale = "id";
const db = createDb(getEnv().DB);
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { items: posts, nextCursor } = await listPublishedPosts(db, {
	locale,
	limit: 20,
	cursor,
});
const groups = groupByYear(posts);
const nos = await getPostNos(
	db,
	locale,
	posts.map((p) => p.id),
);
const pad = (n: number): string => String(n).padStart(3, "0");
const canonical = "/id/writing";
---

<Base
	title={`${t(locale, "writing.title")} — Gurat`}
	description={t(locale, "site.intro")}
	canonical={canonical}
	hreflangs={rootHreflangs(canonical)}
	locale={locale}
	heading={t(locale, "writing.title")}
	path={canonical}
>
	<div class="page">
		{
			posts.length === 0 ? (
				<p>{t(locale, "feed.empty")}</p>
			) : (
				groups.map((g) => (
					<section aria-label={g.year}>
						<div class="section-head">
							<h2>{t(locale, "home.archive")}</h2>
							<span class="mono">{g.year}</span>
						</div>
						{g.posts.map((p) => (
							<div class="archive-row">
								<span class="mono row-no">No. {pad(nos.get(p.id) ?? 1)}</span>
								<a href={localizePath(`/writing/${p.slug}`, locale)}>{p.title}</a>
								<time
									class="mono"
									datetime={
										p.publishedAt !== null
											? new Date(p.publishedAt).toISOString()
											: undefined
									}
								>
									{p.publishedAt !== null ? formatPostDate(p.publishedAt, locale) : ""}
								</time>
							</div>
						))}
					</section>
				))
			)
		}
		{
			nextCursor !== null && (
				<a href={`${canonical}?cursor=${encodeURIComponent(nextCursor)}`} rel="next">
					{t(locale, "writing.next")}
				</a>
			)
		}
	</div>
</Base>
