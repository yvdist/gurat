---
import ArticleBody from "../../../components/ArticleBody.astro";
import Byline from "../../../components/Byline.astro";
import CoverImg from "../../../components/CoverImg.astro";
import PrevNext, { type ClosingCard } from "../../../components/PrevNext.astro";
import TagPill from "../../../components/TagPill.astro";
import Toc from "../../../components/Toc.astro";
import { type Locale, SITE } from "../../../config/site";
import {
	detectLocaleFromPath,
	formatPostDate,
	localizePath,
	t,
} from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import { listingCoverId, postHreflangs } from "../../../lib/archive";
import { getEnv } from "../../../lib/env";
import {
	createDb,
	getAdjacentPosts,
	getMediaById,
	getPostNo,
	getPostNos,
	getPublishedPostBySlug,
	getRelatedPosts,
	getTranslations,
} from "../../../server/db";
import { buildBlogPosting } from "../../../server/discovery/meta";

const locale: Locale = "id";
const db = createDb(getEnv().DB);
const post = await getPublishedPostBySlug(db, locale, Astro.params.slug ?? "");

// Non-public (draft, future-dated, wrong locale, unknown): 404, never
// 403/redirect. The not-found fragment is rendered below with a 404 status.
if (post === null) {
	Astro.response.status = 404;
}
const notFoundLocale: Locale = detectLocaleFromPath(Astro.url.pathname);

const description = post?.seoDescription ?? post?.excerpt ?? "";
const translations =
	post !== null
		? await getTranslations(db, post.translationGroupId, post.id)
		: [];
// Hero cover: explicit cover first, else the first figure in the stored
// editor doc (seed sets no cover_media_id) — the hero never renders empty.
const coverId =
	post?.coverMediaId ?? (post !== null ? listingCoverId(post) : null);
const cover = coverId === null ? null : await getMediaById(db, coverId);
const translation = translations.find((tr) => tr.locale !== locale);
const minutes = post?.readingMinutes ?? 1;
const readingLabel = t(locale, "post.readingMinutes").replace(
	"{minutes}",
	String(minutes),
);
const primaryTag = post?.tags[0];
const pad = (n: number): string => String(n).padStart(3, "0");
const postNo =
	post !== null
		? pad(await getPostNo(db, locale, post.publishedAt, post.id))
		: "000";
const adjacent =
	post !== null
		? await getAdjacentPosts(db, locale, post.publishedAt, post.id)
		: { prev: null, next: null };
const toc: { id: string; text: string; level: number }[] =
	post !== null
		? (JSON.parse(post.tocJson) as {
				id: string;
				text: string;
				level: number;
			}[])
		: [];
const adjacentIds = [
	...(adjacent.prev !== null ? [adjacent.prev.id] : []),
	...(adjacent.next !== null ? [adjacent.next.id] : []),
];
const adjacentNos = await getPostNos(db, locale, adjacentIds);
const prevNo =
	adjacent.prev !== null ? pad(adjacentNos.get(adjacent.prev.id) ?? 1) : "";
const nextNo =
	adjacent.next !== null ? pad(adjacentNos.get(adjacent.next.id) ?? 1) : "";
const relatedRows =
	post !== null
		? await getRelatedPosts(db, {
				locale,
				postId: post.id,
				tagIds: post.tags.map((tag) => tag.id),
			})
		: [];
// Closing cards: RELATED is the first related post (threshold: any shared
// tag), preserving the tag-sharing list contract the tests assert on.
const relatedNos = await getPostNos(
	db,
	locale,
	relatedRows.map((r) => r.id),
);
const toCard = (
	row: {
		slug: string;
		title: string;
		coverMediaId: string | null;
		id: string;
	} | null,
	no: string,
): ClosingCard | null =>
	row === null
		? null
		: {
				slug: row.slug,
				title: row.title,
				postNo: no,
				coverId: row.coverMediaId,
			};
const prevCard = toCard(adjacent.prev, prevNo);
const nextCard = toCard(adjacent.next, nextNo);
const relatedCard =
	relatedRows.length > 0 && relatedRows[0] !== undefined
		? toCard(relatedRows[0], pad(relatedNos.get(relatedRows[0].id) ?? 1))
		: null;
const coverIds = new Set<string>();
for (const card of [prevCard, nextCard, relatedCard]) {
	if (card?.coverId !== null && card?.coverId !== undefined) {
		coverIds.add(card.coverId);
	}
}
const covers = new Map<string, Media>();
for (const id of coverIds) {
	const media = await getMediaById(db, id);
	if (media !== null) covers.set(id, media);
}
const canonical =
	post !== null ? `/id/writing/${post.slug}` : Astro.url.pathname;
// og:image resolution (exact): per-post generated key else static fallback.
const ogBase = getEnv().MEDIA_BASE_URL || SITE.url;
const ogImage =
	post?.ogImageKey !== null && post?.ogImageKey !== undefined
		? `${ogBase}/${post.ogImageKey}`
		: `${SITE.url}/og-default.png`;
const hreflangLinks =
	post !== null ? postHreflangs(locale, post.slug, translations) : [];
const jsonLd =
	post !== null && post.publishedAt !== null
		? buildBlogPosting({
				siteName: SITE.name,
				locale,
				headline: post.title,
				description,
				canonicalUrl: `${SITE.url}${canonical}`,
				ogImage,
				publishedAt: post.publishedAt,
				updatedAt: post.updatedAt,
			})
		: undefined;
---

{
	post === null ? (
		<Base
			title={`${t(notFoundLocale, "notfound.title")} — ${SITE.name}`}
			description={t(notFoundLocale, "notfound.body")}
			canonical={Astro.url.pathname}
			hreflangs={[]}
			locale={notFoundLocale}
			path={Astro.url.pathname}
		>
			<div class="page">
				<h1>{t(notFoundLocale, "notfound.title")}</h1>
				<p>{t(notFoundLocale, "notfound.body")}</p>
			</div>
		</Base>
	) : (
		<Base
			title={`${post.title} — ${SITE.name}`}
			description={description}
			canonical={canonical}
			hreflangs={hreflangLinks}
			locale={locale}
			path={canonical}
			ogImage={ogImage}
			ogType="article"
			publishedAt={post.publishedAt ?? undefined}
			updatedAt={post.updatedAt}
			jsonLd={jsonLd}
		>
			<div class="page">
				<header class="post-head">
					<p class="mono post-eyebrow">
						NO. {postNo}
						{" · "}
						<time datetime={post.publishedAt !== null ? new Date(post.publishedAt).toISOString() : undefined}>
							{post.publishedAt !== null ? formatPostDate(post.publishedAt, locale) : ""}
						</time>
						{" · "}
						<span>{readingLabel}</span>
						{primaryTag !== undefined && (
							<span>
								{" · "}
								{primaryTag.labelId}
							</span>
						)}
					</p>
					<h1>{post.title}</h1>
					<p class="post-lede">{post.excerpt}</p>
					<p class="mono post-byline">
						{t(locale, "post.writtenBy").replace("{name}", SITE.name)}
					</p>
					{translation !== undefined && (
						<a
							class="mono post-translation"
							href={localizePath(`/writing/${translation.slug}`, translation.locale)}
						>
							{translation.locale === "id"
								? t("id", "post.translationId")
								: t("en", "post.translationEn")}
						</a>
					)}
				</header>
				{cover !== null && (
					<div class="post-cover">
						<CoverImg media={cover} baseUrl={getEnv().MEDIA_BASE_URL} />
					</div>
				)}
				<div class="post-grid">
					<Toc locale={locale} entries={toc} />
					<ArticleBody html={post.contentHtml} />
					<aside class="post-sidenotes" aria-hidden="true" />
				</div>
				{post.tags.length > 0 && (
					<div class="post-tags">
						{post.tags.map((tag) => (
							<TagPill locale={locale} slug={tag.slug} label={tag.labelId} />
						))}
					</div>
				)}
				<Byline
					locale={locale}
					canonical={`${SITE.url}${canonical}`}
					email={t(locale, "about.contactEmail")}
				/>
				<PrevNext
					locale={locale}
					prev={prevCard}
					related={relatedCard}
					next={nextCard}
					covers={covers}
				/>
			</div>
		</Base>
	)
}
