---
import { type Locale, SITE } from "../../../config/site";
import {
	detectLocaleFromPath,
	formatPostDate,
	localizePath,
	t,
} from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import { getEnv } from "../../../lib/env";
import { createDb, getPostNos, listPublishedPosts, listTags } from "../../../server/db";

const locale: Locale = "id";
const db = createDb(getEnv().DB);
const tagSlug = Astro.params.slug ?? "";
const tags = await listTags(db, locale);
const tag = tags.find((tg) => tg.slug === tagSlug) ?? null;

// Unknown tag slug: 404 like an unknown post slug.
if (tag === null) {
	Astro.response.status = 404;
}
const notFoundLocale: Locale = detectLocaleFromPath(Astro.url.pathname);

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { items: posts, nextCursor } =
	tag === null
		? { items: [], nextCursor: null }
		: await listPublishedPosts(db, { locale, tagSlug, limit: 20, cursor });
const nos = await getPostNos(
	db,
	locale,
	posts.map((p) => p.id),
);
const pad = (n: number): string => String(n).padStart(3, "0");
const tagLabel = tag === null ? tagSlug : tag.labelId;
const canonical = `/id/tags/${tagSlug}`;
---

{
	tag === null ? (
		<Base
			title={`${t(notFoundLocale, "notfound.title")} — ${SITE.name}`}
			description={t(notFoundLocale, "notfound.body")}
			canonical={Astro.url.pathname}
			hreflangs={[]}
			locale={notFoundLocale}
			heading={t(notFoundLocale, "notfound.title")}
			path={Astro.url.pathname}
		>
			<p>{t(notFoundLocale, "notfound.body")}</p>
		</Base>
	) : (
		<Base
			title={`${tagLabel} — ${t(locale, "tags.title")} — ${SITE.name}`}
			description={t(locale, "site.intro")}
			canonical={canonical}
			hreflangs={[]}
			locale={locale}
			heading={tagLabel}
			path={canonical}
		>
			<div class="page">
				{posts.length === 0 ? (
					<p>{t(locale, "feed.empty")}</p>
				) : (
					posts.map((p) => (
						<div class="archive-row">
							<span class="mono row-no">No. {pad(nos.get(p.id) ?? 1)}</span>
							<a href={localizePath(`/writing/${p.slug}`, locale)}>{p.title}</a>
							<time
								class="mono"
								datetime={
									p.publishedAt !== null
										? new Date(p.publishedAt).toISOString()
										: undefined
								}
							>
								{p.publishedAt !== null ? formatPostDate(p.publishedAt, locale) : ""}
							</time>
						</div>
					))
				)}
				{nextCursor !== null && (
					<a href={`${canonical}?cursor=${encodeURIComponent(nextCursor)}`} rel="next">
						{t(locale, "writing.next")}
					</a>
				)}
			</div>
		</Base>
	)
}
