---
import type { Locale } from "../../../config/site";
import { localizePath, t } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import { rootHreflangs } from "../../../lib/archive";
import { getEnv } from "../../../lib/env";
import { createDb, listTags } from "../../../server/db";

const locale: Locale = "id";
const db = createDb(getEnv().DB);
const tags = await listTags(db, locale);
const TAG_KANJI: Record<string, string> = {
	essays: "随筆",
	notes: "技術",
	tech: "映画",
	journal: "音楽",
};
const canonical = "/id/tags";
---

<Base
	title={`${t(locale, "tags.title")} — Gurat`}
	description={t(locale, "site.intro")}
	canonical={canonical}
	hreflangs={rootHreflangs(canonical)}
	locale={locale}
	heading={t(locale, "tags.title")}
	path={canonical}
>
	<div class="page">
		{
			tags.length === 0 ? (
				<p>{t(locale, "feed.empty")}</p>
			) : (
				<div class="topic-grid">
					{tags.map((tag) => (
						<a class="topic" href={localizePath(`/tags/${tag.slug}`, locale)}>
							<p class="mono kanji">{TAG_KANJI[tag.slug] ?? tag.slug}</p>
							<h3>{tag.labelId}</h3>
							<p class="mono">{tag.postCount}</p>
						</a>
					))}
				</div>
			)
		}
	</div>
</Base>
