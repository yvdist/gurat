---
import ArticleBody from "../../components/ArticleBody.astro";
import Byline from "../../components/Byline.astro";
import CoverImg from "../../components/CoverImg.astro";
import PrevNext from "../../components/PrevNext.astro";
import TagPill from "../../components/TagPill.astro";
import Toc from "../../components/Toc.astro";
import { type Locale, SITE } from "../../config/site";
import {
	detectLocaleFromPath,
	formatPostDate,
	localizePath,
	t,
} from "../../i18n";
import Base from "../../layouts/Base.astro";
import { postHreflangs } from "../../lib/archive";
import { getEnv } from "../../lib/env";
import {
	createDb,
	getAdjacentPosts,
	getMediaById,
	getPostNo,
	getPostNos,
	getPublishedPostBySlug,
	getTranslations,
} from "../../server/db";
import { buildBlogPosting } from "../../server/discovery/meta";

const locale: Locale = "en";
const db = createDb(getEnv().DB);
const post = await getPublishedPostBySlug(db, locale, Astro.params.slug ?? "");

// Non-public (draft, future-dated, wrong locale, unknown): 404, never
// 403/redirect. The not-found fragment is rendered below with a 404 status.
if (post === null) {
	Astro.response.status = 404;
}
const notFoundLocale: Locale = detectLocaleFromPath(Astro.url.pathname);

const description = post?.seoDescription ?? post?.excerpt ?? "";
const translations =
	post !== null
		? await getTranslations(db, post.translationGroupId, post.id)
		: [];
const cover =
	post?.coverMediaId !== null && post?.coverMediaId !== undefined
		? await getMediaById(db, post.coverMediaId)
		: null;
const translation = translations.find((tr) => tr.locale !== locale);
const otherLocale: Locale = "id";
const translationHref =
	translation !== undefined
		? localizePath(`/writing/${translation.slug}`, translation.locale)
		: localizePath("/", otherLocale);
const minutes = post?.readingMinutes ?? 1;
const readingLabel = t(locale, "post.readingMinutes").replace(
	"{minutes}",
	String(minutes),
);
const primaryTag = post?.tags[0];
const pad = (n: number): string => String(n).padStart(3, "0");
// Post number, translation date, adjacent posts, toc entries (stored JSON).
const postNo =
	post !== null
		? pad(await getPostNo(db, locale, post.publishedAt, post.id))
		: "000";
const adjacent =
	post !== null
		? await getAdjacentPosts(db, locale, post.publishedAt, post.id)
		: { prev: null, next: null };
const toc: { id: string; text: string; level: number }[] =
	post !== null
		? (JSON.parse(post.tocJson) as {
				id: string;
				text: string;
				level: number;
			}[])
		: [];
const adjacentIds = [
	...(adjacent.prev !== null ? [adjacent.prev.id] : []),
	...(adjacent.next !== null ? [adjacent.next.id] : []),
];
const adjacentNos = await getPostNos(db, locale, adjacentIds);
const prevNo =
	adjacent.prev !== null ? pad(adjacentNos.get(adjacent.prev.id) ?? 1) : "";
const nextNo =
	adjacent.next !== null ? pad(adjacentNos.get(adjacent.next.id) ?? 1) : "";
const canonical = post !== null ? `/writing/${post.slug}` : Astro.url.pathname;
// og:image resolution: per-post key (step 4 column) else static fallback.
// Column not yet migrated — fallback only until then.
const ogImage = `${SITE.url}/og-default.png`;
const hreflangLinks =
	post !== null ? postHreflangs(locale, post.slug, translations) : [];
const jsonLd =
	post !== null && post.publishedAt !== null
		? buildBlogPosting({
				siteName: SITE.name,
				locale,
				headline: post.title,
				description,
				canonicalUrl: `${SITE.url}${canonical}`,
				ogImage,
				publishedAt: post.publishedAt,
				updatedAt: post.updatedAt,
			})
		: undefined;
---

{
	post === null ? (
		<Base
			title={`${t(notFoundLocale, "notfound.title")} — ${SITE.name}`}
			description={t(notFoundLocale, "notfound.body")}
			canonical={Astro.url.pathname}
			hreflangs={[]}
			locale={notFoundLocale}
			heading={t(notFoundLocale, "notfound.title")}
			path={Astro.url.pathname}
		>
			<p>{t(notFoundLocale, "notfound.body")}</p>
		</Base>
	) : (
		<Base
			title={`${post.title} — ${SITE.name}`}
			description={description}
			canonical={canonical}
			hreflangs={hreflangLinks}
			locale={locale}
			path={canonical}
			ogImage={ogImage}
			ogType="article"
			publishedAt={post.publishedAt ?? undefined}
			updatedAt={post.updatedAt}
			jsonLd={jsonLd}
		>
			<div class="page">
				<p class="mono breadcrumb">
					<a href={localizePath("/writing", locale)}>writing</a>
					{" / "}
					{primaryTag !== undefined && (
						<span>{locale === "en" ? primaryTag.labelEn : primaryTag.labelId} / </span>
					)}
					<span class="crumb-no">No. {postNo}</span>
				</p>
				{post.tags.length > 0 && (
					<div class="pill-row">
						{post.tags.slice(0, 2).map((tag) => (
							<TagPill
								locale={locale}
								slug={tag.slug}
								label={locale === "en" ? tag.labelEn : tag.labelId}
							/>
						))}
					</div>
				)}
				{cover !== null && <CoverImg media={cover} baseUrl={getEnv().MEDIA_BASE_URL} />}
				<h1>{post.title}</h1>
				<p class="post-lede">{post.excerpt}</p>
				<div class="post-meta">
					<span class="mono">
						<time datetime={post.publishedAt !== null ? new Date(post.publishedAt).toISOString() : undefined}>
							{post.publishedAt !== null ? formatPostDate(post.publishedAt, locale) : ""}
						</time>
						{post.publishedAt !== null && post.updatedAt !== post.publishedAt && (
							<span>
								{" · "}
								{t(locale, "post.updated").replace("{date}", formatPostDate(post.updatedAt, locale))}
							</span>
						)}
						{" · "}
						<span>{readingLabel}</span>
					</span>
					<a class="mono" href={translationHref}>
						{translation !== undefined
							? translation.locale === "en"
								? "English"
								: "Bahasa Indonesia"
							: t(otherLocale, "nav.home")}
					</a>
				</div>
				<figure>
					<div class="hero-panel" aria-hidden="true">
						<div class="arc" />
					</div>
				</figure>
				<div class="post-grid">
					<Toc locale={locale} entries={toc} />
					<ArticleBody html={post.contentHtml} />
					<aside class="post-sidenotes" aria-hidden="true" />
				</div>
				<Byline locale={locale} canonical={`${SITE.url}${canonical}`} />
				<PrevNext
					locale={locale}
					prev={adjacent.prev !== null ? { slug: adjacent.prev.slug, title: adjacent.prev.title, postNo: prevNo } : null}
					next={adjacent.next !== null ? { slug: adjacent.next.slug, title: adjacent.next.title, postNo: nextNo } : null}
				/>
			</div>
		</Base>
	)
}
