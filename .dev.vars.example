# Local-only secrets/vars for `astro dev` / `wrangler dev`. Never commit `.dev.vars`.
SITE_URL=http://localhost:4321
# Access (local dev only). Real values come from the Cloudflare dashboard;
# never commit `.dev.vars`.
# ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# ACCESS_AUD=<application AUD tag>
# ADMIN_EMAILS=you@example.com
# ADMIN_DEV_BYPASS=1  # local e2e only, DEV-only
# Media (Phase 5): empty = same-origin `/media/...` (local R2 emulation);
# prod = `https://media.<domain>` (public R2 custom domain, no Worker hit).
MEDIA_BASE_URL=
# KEEP_ORIGINALS=false
