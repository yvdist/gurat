{
	"name": "gurat",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"test": "pnpm exec vitest run",
		"e2e": "pnpm exec playwright test",
		"check": "pnpm exec astro check && pnpm exec biome check . && pnpm exec vitest run",
		"types": "wrangler types src/worker-configuration.d.ts",
		"db:migrate:local": "wrangler d1 migrations apply gurat --local",
		"db:migrate:remote": "wrangler d1 migrations apply gurat --remote",
		"db:seed:local": "tsx scripts/seed.ts > .seed.sql && wrangler d1 execute gurat --local --file .seed.sql && rm -f .seed.sql",
		"db:rerender": "pnpm exec tsx scripts/rerender.ts",
		"media:orphans": "pnpm exec tsx scripts/media-orphans.ts"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.4.3",
		"@astrojs/svelte": "9.1.2",
		"@fontsource/bodoni-moda": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@fontsource/newsreader": "5.3.0",
		"@tiptap/core": "3.32.2",
		"@tiptap/extension-link": "3.32.2",
		"@tiptap/starter-kit": "3.32.2",
		"astro": "7.4.4",
		"drizzle-orm": "0.45.4",
		"jose": "6.2.14",
		"svelte": "5.57.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@biomejs/biome": "2.6.4",
		"@cloudflare/vite-plugin": "1.66.0",
		"@cloudflare/vitest-plugin": "1.4.11",
		"@cloudflare/workers-types": "5.20261101.1",
		"@playwright/test": "1.64.1",
		"@types/node": "22.20.5",
		"drizzle-kit": "0.31.11",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"vitest": "4.1.12",
		"wrangler": "4.156.1"
	}
}
