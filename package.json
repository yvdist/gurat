{
  "name": "gurat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && biome check . && vitest run",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gurat --local",
    "db:migrate:remote": "wrangler d1 migrations apply gurat --remote",
    "db:seed:local": "tsx scripts/seed.ts > .seed.sql && wrangler d1 execute gurat --local --file .seed.sql && rm -f .seed.sql"
  },
  "dependencies": {
    "astro": "7.4.4",
    "@astrojs/cloudflare": "14.4.3",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261101.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.1"
  }
}
