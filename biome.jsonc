{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"linter": {
				"rules": {
					"correctness": {
						// Biome can't see frontmatter use in Astro markup: both
						// imports and frontmatter bindings consumed only by the
						// template read as unused. Real dead code in .astro
						// frontmatter is caught by astro check / review.
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			},
			"includes": ["**/*.astro", "*.astro"]
		}
	]
}
